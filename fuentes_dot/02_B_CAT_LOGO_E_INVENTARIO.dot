digraph Modulo_B {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.75", splines=polyline, fontname="Arial", labelloc=t, label="FACTURATE · MÓDULO B · CATÁLOGO E INVENTARIO · NOTACIÓN CROW’S FOOT", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", arrowsize=0.65];
subgraph cluster_local_B { label="Entidades del módulo"; color="#2F7A4B"; style="rounded"; penwidth=1.3; fontname="Arial"; fontsize=12;
categorias_productos [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>categorias_productos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">categoria_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_categoria</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(80)</FONT></TD></TR></TABLE>>];
productos [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>productos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">categoria_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">codigo_producto</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_producto</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">descripcion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">precio_venta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_item_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">maneja_inventario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
tipos_items [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>tipos_items</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_item_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">descripcion_tipo_item</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
inventarios [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>inventarios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">inventario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cantidad_disponible</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">stock_minimo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_actualizacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR></TABLE>>];
movimientos_inventario [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>movimientos_inventario</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">movimiento_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">inventario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_movimiento_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cantidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_movimiento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">motivo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">venta_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">compra_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">devolucion_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR></TABLE>>];
tipos_movimientos [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>tipos_movimientos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_movimiento_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">efecto_movimiento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">CHAR(1)</FONT></TD></TR></TABLE>>];
alertas_inventario [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>alertas_inventario</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">alerta_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">inventario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_alerta_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_generacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_resolucion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR></TABLE>>];
tipos_alerta [label=<<TABLE BORDER="1" COLOR="#2F7A4B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF7EF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>tipos_alerta</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO B</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_alerta_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">descripcion_alerta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">prioridad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
}
subgraph cluster_external { label="Referencias de otros módulos"; color="#CBD5E1"; style="dashed,rounded"; fontname="Arial"; fontsize=11;
compras [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>compras</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo C</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">compra_id</FONT></TD></TR></TABLE>>];
devoluciones [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>devoluciones</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo H</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">devolucion_id</FONT></TD></TR></TABLE>>];
negocios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD></TR></TABLE>>];
usuarios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>usuarios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD></TR></TABLE>>];
ventas [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>ventas</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo D</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">venta_id</FONT></TD></TR></TABLE>>];
}
negocios -> categorias_productos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
negocios -> productos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
categorias_productos -> productos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="categoria_id", labelfontcolor="#475569"];
tipos_items -> productos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="tipo_item_id", labelfontcolor="#475569"];
productos -> inventarios [dir=both, arrowtail=tee, arrowhead=odottee, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="producto_id", labelfontcolor="#475569"];
inventarios -> movimientos_inventario [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="inventario_id", labelfontcolor="#475569"];
tipos_movimientos -> movimientos_inventario [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="tipo_movimiento_id", labelfontcolor="#475569"];
usuarios -> movimientos_inventario [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="usuario_id", labelfontcolor="#475569"];
ventas -> movimientos_inventario [dir=both, arrowtail=odottee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="venta_id", labelfontcolor="#475569"];
compras -> movimientos_inventario [dir=both, arrowtail=odottee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="compra_id", labelfontcolor="#475569"];
devoluciones -> movimientos_inventario [dir=both, arrowtail=odottee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="devolucion_id", labelfontcolor="#475569"];
inventarios -> alertas_inventario [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="inventario_id", labelfontcolor="#475569"];
tipos_alerta -> alertas_inventario [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="tipo_alerta_id", labelfontcolor="#475569"];
}