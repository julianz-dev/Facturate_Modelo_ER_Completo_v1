digraph Modulo_F {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.75", splines=polyline, fontname="Arial", labelloc=t, label="FACTURATE · MÓDULO F · CONFIGURACIÓN · NOTACIÓN CROW’S FOOT", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", arrowsize=0.65];
subgraph cluster_local_F { label="Entidades del módulo"; color="#28717A"; style="rounded"; penwidth=1.3; fontname="Arial"; fontsize=12;
metodos_pago [label=<<TABLE BORDER="1" COLOR="#28717A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF5F6" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>metodos_pago</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO F</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">metodo_pago_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_metodo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(50)</FONT></TD></TR></TABLE>>];
negocio_metodos_pago [label=<<TABLE BORDER="1" COLOR="#28717A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF5F6" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocio_metodos_pago</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO F</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">metodo_pago_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
impuestos [label=<<TABLE BORDER="1" COLOR="#28717A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF5F6" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>impuestos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO F</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">impuesto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_impuesto</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(80)</FONT></TD></TR></TABLE>>];
negocio_impuestos [label=<<TABLE BORDER="1" COLOR="#28717A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF5F6" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocio_impuestos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO F</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">impuesto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">porcentaje</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
producto_impuestos [label=<<TABLE BORDER="1" COLOR="#28717A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF5F6" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>producto_impuestos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO F</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">producto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">impuesto_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">porcentaje</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(5,2)</FONT></TD></TR></TABLE>>];
}
subgraph cluster_external { label="Referencias de otros módulos"; color="#CBD5E1"; style="dashed,rounded"; fontname="Arial"; fontsize=11;
negocios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD></TR></TABLE>>];
productos [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>productos</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo B</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">producto_id</FONT></TD></TR></TABLE>>];
}
negocios -> negocio_metodos_pago [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
metodos_pago -> negocio_metodos_pago [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="metodo_pago_id", labelfontcolor="#475569"];
negocios -> negocio_impuestos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
impuestos -> negocio_impuestos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="impuesto_id", labelfontcolor="#475569"];
productos -> producto_impuestos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id + producto_id · compuesta", labelfontcolor="#475569"];
negocio_impuestos -> producto_impuestos [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id + impuesto_id + porcentaje · compuesta", labelfontcolor="#475569"];
}