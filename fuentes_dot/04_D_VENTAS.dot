ventas [label=<<TABLE BORDER="1" COLOR="#A4475D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FCEEF1" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>ventas</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO D</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">venta_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid_local</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">UNIQUEIDENTIFIER</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cliente_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_venta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">estado_venta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">subtotal</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">descuento_total</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">impuesto_total</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">total_venta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">origen_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR></TABLE>>];
