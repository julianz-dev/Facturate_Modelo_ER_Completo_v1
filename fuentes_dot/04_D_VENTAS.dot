digraph Modulo_D {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.75", splines=polyline, fontname="Arial", labelloc=t, label="FACTURATE · MÓDULO D · VENTAS · NOTACIÓN CROW’S FOOT", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", arrowsize=0.65];
subgraph cluster_local_D { label="Entidades del módulo"; color="#A4475D"; style="rounded"; penwidth=1.3; fontname="Arial"; fontsize=12;
clientes [label=<<TABLE BORDER="1" COLOR="#A4475D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FCEEF1" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>clientes</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO D</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cliente_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_documento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">numero_documento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_razon_social</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">es_generico</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
