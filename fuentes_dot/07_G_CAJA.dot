digraph Modulo_G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.75", splines=polyline, fontname="Arial", labelloc=t, label="FACTURATE · MÓDULO G · CAJA · NOTACIÓN CROW’S FOOT", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", arrowsize=0.65];
subgraph cluster_local_G { label="Entidades del módulo"; color="#B75C32"; style="rounded"; penwidth=1.3; fontname="Arial"; fontsize=12;
cierres_caja [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>cierres_caja</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cierre_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_apertura_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_cierre_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_apertura</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_cierre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">saldo_inicial_efectivo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">estado_caja_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR></TABLE>>];
estados_caja [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>estados_caja</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">estado_caja_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(20)</FONT></TD></TR></TABLE>>];
detalles_cierres_caja [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>detalles_cierres_caja</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">detalle_cierre_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cierre_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">metodo_pago_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">valor_esperado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">valor_contado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>—</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">diferencia</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">Computado</FONT></TD></TR></TABLE>>];
denominaciones [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>denominaciones</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">denominacion_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">valor_denominacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_denominacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
arqueos_caja [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>arqueos_caja</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">arqueo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cierre_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_hora</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">valor_esperado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DECIMAL(14,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_arqueo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR></TABLE>>];
tipos_arqueo [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>tipos_arqueo</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_arqueo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(30)</FONT></TD></TR></TABLE>>];
detalles_arqueo [label=<<TABLE BORDER="1" COLOR="#B75C32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF0E8" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>detalles_arqueo</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO G</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">detalle_arqueo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">arqueo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">denominacion_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cantidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">INT</FONT></TD></TR></TABLE>>];
}
subgraph cluster_external { label="Referencias de otros módulos"; color="#CBD5E1"; style="dashed,rounded"; fontname="Arial"; fontsize=11;
metodos_pago [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>metodos_pago</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo F</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">metodo_pago_id</FONT></TD></TR></TABLE>>];
negocios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD></TR></TABLE>>];
usuarios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>usuarios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD></TR></TABLE>>];
}
negocios -> cierres_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
usuarios -> cierres_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="usuario_apertura_id", labelfontcolor="#475569"];
usuarios -> cierres_caja [dir=both, arrowtail=odottee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="usuario_cierre_id", labelfontcolor="#475569"];
estados_caja -> cierres_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="estado_caja_id", labelfontcolor="#475569"];
negocios -> detalles_cierres_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
cierres_caja -> detalles_cierres_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="cierre_id", labelfontcolor="#475569"];
metodos_pago -> detalles_cierres_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="metodo_pago_id", labelfontcolor="#475569"];
negocios -> arqueos_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
cierres_caja -> arqueos_caja [dir=both, arrowtail=odottee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="cierre_id", labelfontcolor="#475569"];
usuarios -> arqueos_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="usuario_id", labelfontcolor="#475569"];
tipos_arqueo -> arqueos_caja [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="tipo_arqueo_id", labelfontcolor="#475569"];
arqueos_caja -> detalles_arqueo [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="arqueo_id", labelfontcolor="#475569"];
denominaciones -> detalles_arqueo [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="denominacion_id", labelfontcolor="#475569"];
}