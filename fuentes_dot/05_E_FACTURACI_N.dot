digraph Modulo_E {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.75", splines=polyline, fontname="Arial", labelloc=t, label="FACTURATE · MÓDULO E · FACTURACIÓN · NOTACIÓN CROW’S FOOT", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", arrowsize=0.65];
subgraph cluster_local_E { label="Entidades del módulo"; color="#6652A3"; style="rounded"; penwidth=1.3; fontname="Arial"; fontsize=12;
facturas [label=<<TABLE BORDER="1" COLOR="#6652A3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1EDFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>facturas</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO E</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">factura_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">venta_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">numero_factura</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_emision</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ruta_pdf</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">hash_documento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">CHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">estado_factura</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">VARCHAR(20)</FONT></TD></TR></TABLE>>];
configuraciones_factura [label=<<TABLE BORDER="1" COLOR="#6652A3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1EDFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>configuraciones_factura</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO E</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">configuracion_factura_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ruta_logo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">color_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">mensaje_factura</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">informacion_adicional</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(1000)</FONT></TD></TR></TABLE>>];
paleta_colores_negocio [label=<<TABLE BORDER="1" COLOR="#6652A3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1EDFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>paleta_colores_negocio</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO E</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">color_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_color</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">codigo_hex</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">CHAR(7)</FONT></TD></TR></TABLE>>];
correcciones_facturas [label=<<TABLE BORDER="1" COLOR="#6652A3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1EDFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>correcciones_facturas</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO E</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">correccion_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">factura_original_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">factura_nueva_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">motivo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_correccion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR></TABLE>>];
motivos_correccion [label=<<TABLE BORDER="1" COLOR="#6652A3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1EDFF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>motivos_correccion</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO E</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">motivo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">descripcion_motivo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(200)</FONT></TD></TR></TABLE>>];
}
subgraph cluster_external { label="Referencias de otros módulos"; color="#CBD5E1"; style="dashed,rounded"; fontname="Arial"; fontsize=11;
negocios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD></TR></TABLE>>];
usuarios [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>usuarios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD></TR></TABLE>>];
ventas [label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#F1F3F5" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>ventas</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">EXTERNA · Módulo D</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#64748B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">venta_id</FONT></TD></TR></TABLE>>];
}
negocios -> facturas [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
ventas -> facturas [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="venta_id", labelfontcolor="#475569"];
negocios -> configuraciones_factura [dir=both, arrowtail=tee, arrowhead=odottee, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
paleta_colores_negocio -> configuraciones_factura [dir=both, arrowtail=odottee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="color_id", labelfontcolor="#475569"];
negocios -> paleta_colores_negocio [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
facturas -> correcciones_facturas [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id + factura_original_id · compuesta", labelfontcolor="#475569"];
facturas -> correcciones_facturas [dir=both, arrowtail=tee, arrowhead=odottee, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id + factura_nueva_id · compuesta", labelfontcolor="#475569"];
usuarios -> correcciones_facturas [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id + usuario_id · compuesta", labelfontcolor="#475569"];
motivos_correccion -> correcciones_facturas [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="motivo_id", labelfontcolor="#475569"];
}