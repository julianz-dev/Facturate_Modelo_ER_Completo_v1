digraph Modulo_A {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.75", splines=polyline, fontname="Arial", labelloc=t, label="FACTURATE · MÓDULO A · USUARIOS Y NEGOCIO · NOTACIÓN CROW’S FOOT", fontsize=18];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", arrowsize=0.65];
subgraph cluster_local_A { label="Entidades del módulo"; color="#2D5B9A"; style="rounded"; penwidth=1.3; fontname="Arial"; fontsize=12;
negocios [label=<<TABLE BORDER="1" COLOR="#2D5B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>negocios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO A</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_negocio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NULL</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nit</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_creacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR></TABLE>>];
telefonos_negocio [label=<<TABLE BORDER="1" COLOR="#2D5B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>telefonos_negocio</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO A</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">telefono_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">numero_telefono</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(25)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tipo_telefono</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">VARCHAR(10)</FONT></TD></TR></TABLE>>];
correos_negocio [label=<<TABLE BORDER="1" COLOR="#2D5B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>correos_negocio</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO A</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">correo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">correo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(254)</FONT></TD></TR></TABLE>>];
direcciones_negocio [label=<<TABLE BORDER="1" COLOR="#2D5B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>direcciones_negocio</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO A</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">direccion_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">direccion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ciudad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(100)</FONT></TD></TR></TABLE>>];
roles [label=<<TABLE BORDER="1" COLOR="#2D5B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>roles</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO A</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rol_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_rol</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR></TABLE>>];
usuarios [label=<<TABLE BORDER="1" COLOR="#2D5B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#EAF2FF" ALIGN="LEFT" CELLPADDING="6"><FONT POINT-SIZE="12"><B>usuarios</B></FONT><BR/><FONT POINT-SIZE="8" COLOR="#475569">MÓDULO A</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#9A3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT IDENTITY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">negocio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#1D4ED8"><B>FK,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rol_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nombre_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>UQ,NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">correo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(254)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">password_hash</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">NVARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">BIT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><FONT POINT-SIZE="8" COLOR="#64748B"><B>NN</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fecha_creacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">DATETIME2(0)</FONT></TD></TR></TABLE>>];
}
negocios -> telefonos_negocio [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
negocios -> correos_negocio [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
negocios -> direcciones_negocio [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
negocios -> usuarios [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="negocio_id", labelfontcolor="#475569"];
roles -> usuarios [dir=both, arrowtail=tee, arrowhead=odotcrow, color="#64748B", penwidth=1.05, fontsize=7, fontname="Arial", label="rol_id", labelfontcolor="#475569"];
}